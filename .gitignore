# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
prisma/hive-tracking.db*
/hive-tracking.db*
/prisma/dev.db*

# Claude Code local user prefs
.claude/settings.local.json
.claude/worktrees/
AGENTS.local.md

# Container upload artefact produced by `make container.zip`.
container.zip

.mcp.json

# Local dev SQLite database
/dev.db
/dev.db*

# Ignore all local SQLite databases anywhere
*.db
*.db-journal
*.db-wal
*.db-shm

# Session screenshot scratch (local walkthrough captures)
.screenshots/
