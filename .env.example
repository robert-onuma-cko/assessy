# Local Postgres (docker compose -f docker-compose.dev.yml up -d)
DATABASE_URL="postgresql://assessy:assessy@localhost:5433/assessy"

# Local dev identity (see lib/cf-auth.ts — dev impersonation only, dead code in prod)
ASSESSY_DEV_EMAIL="robert.onuma@checkout.com"

# Comma-separated triage leads (may pick triage outcomes; see lib/permissions.ts)
ASSESSY_TRIAGE_LEADS="robert.onuma@checkout.com,emmanuel.lawal@checkout.com"

# Local dev only: gives the Finance/FEX pilot domains a placeholder approval
# owner at seed time so /my-work is exercisable before the DomainPOC export.
ASSESSY_DEV_PILOT_OWNER="robert.onuma@checkout.com"

# AI providers (week 3 — lib/ai.ts; not needed for the week-1 scaffold)
AI_PROVIDER="mock"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

APP_URL="http://localhost:3005"

# Confluence read access for evidence links (same Atlassian token as Jira; see
# lib/confluence.ts). Leave blank locally — AI_PROVIDER=mock returns canned text
# for any https link instead.
JIRA_SUBDOMAIN=""
JIRA_USERNAME=""
JIRA_API_KEY=""

# Hive export the domain catalogue + initiative list are imported from at seed
# time (prisma/seed.ts). Defaults to the trimmed copy in prisma/data.
HIVE_SNAPSHOT_PATH="prisma/data/hive-snapshot-2026-09-16.json"
HIVE_APP_URL="https://hive.aisandbox.dev.ckotech.internal"
